# ─── Minecraft EasyProxi — Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── Microsoft OAuth (Azure App Registration) ────────────────────────────────
# Setup: https://portal.azure.com → App registrations → New registration
#
# 1. Create new app: "Minecraft EasyProxi"
# 2. Supported account types: Personal Microsoft accounts only
# 3. Redirect URI: Web → http://localhost:3000/login.html
# 4. After creation → Certificates & secrets → New client secret
# 5. API permissions → Add: User.Read, XboxLive.signin, openid, profile, email
#
MS_CLIENT_ID=YOUR_AZURE_CLIENT_ID_HERE
MS_CLIENT_SECRET=YOUR_AZURE_CLIENT_SECRET_HERE
MS_TENANT=common
MS_REDIRECT_URI=http://localhost:3000/login.html

# Production redirect URI (uncomment when deploying):
# MS_REDIRECT_URI=https://minecraft.easyproxi.online/login.html

# ─── Minecraft Server ────────────────────────────────────────────────────────
MC_DEFAULT_VERSION=1.20.4
MC_DEFAULT_RAM=2G
MC_MAX_SESSIONS=10

# ─── Security ────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_secret_string_at_least_32_chars
SESSION_SECRET=another_random_secret_for_sessions
